<?xml version="1.0" encoding="utf-8"?>
<Page
	x:Class="Pso2Tools.Defrost.Views.PreviewPageDds"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Pso2Tools.Defrost.Views"
	xmlns:defrost="using:Pso2Tools.Defrost"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:ui="using:CommunityToolkit.WinUI"
	xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
	xmlns:controls="using:CommunityToolkit.WinUI.Controls"
	mc:Ignorable="d"
>
	<Grid SizeChanged="Grid_SizeChanged">
		<Grid.Resources>
			<Style
				x:Name="NarrowSegmentedStyle"
				TargetType="controls:Segmented"
				BasedOn="{StaticResource DefaultSegmentedStyle}"
			>
				<Setter Property="ItemsPanel">
					<Setter.Value>
						<ItemsPanelTemplate>
							<StackPanel
								HorizontalAlignment="Center"
								Orientation="Horizontal"
								Spacing="{ThemeResource SegmentedItemSpacing}"
							/>
						</ItemsPanelTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<Style
				x:Name="NarrowButtonStyle"
				TargetType="Button"
				BasedOn="{StaticResource SubtleButtonStyle}"
			>
				<Setter Property="Padding" Value="5" />
			</Style>
		</Grid.Resources>

		<VisualStateManager.VisualStateGroups>
			<VisualStateGroup>
				<VisualState x:Name="Collapsed" />
				<VisualState x:Name="Expanded">
					<VisualState.StateTriggers>
						<AdaptiveTrigger MinWindowWidth="720" />
					</VisualState.StateTriggers>
					<VisualState.Setters>
						<Setter Target="ColorChannels.Visibility" Value="Visible" />
						<Setter Target="ColorChannelsComboBox.Visibility" Value="Collapsed" />
					</VisualState.Setters>
				</VisualState>
			</VisualStateGroup>
		</VisualStateManager.VisualStateGroups>

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>

		<StackPanel
			Orientation="Horizontal"
			Spacing="8"
			Padding="8"
			BorderThickness="0,0,0,1"
			BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
		>
			<Button
				x:Name="ZoomToFitButton"
				Style="{StaticResource NarrowButtonStyle}"
				Click="ZoomToFitButton_Click"
				ToolTipService.ToolTip="Zoom to fit"
			>
				<FontIcon Glyph="&#xE9A6;" />
			</Button>

			<Button
				x:Name="ZoomActualSize"
				Style="{StaticResource NarrowButtonStyle}"
				Click="ZoomActualSize_Click"
				ToolTipService.ToolTip="Original size"
			>
				<FontIcon Glyph="&#xE8B8;" />
			</Button>

			<controls:Segmented
				x:Name="ColorChannels"
				Visibility="Collapsed"
				Style="{StaticResource NarrowSegmentedStyle}"
				ItemsSource="{ui:EnumValues Type=defrost:ImagePreviewMode}"
				ItemTemplate="{StaticResource EnumDisplayNameTemplate}"
				SelectedItem="{x:Bind settings.ImagePreviewMode, Mode=OneWay}"
				SelectionChanged="ColorChannels_SelectionChanged"
			/>

			<ComboBox
				x:Name="ColorChannelsComboBox"
				ItemsSource="{ui:EnumValues Type=defrost:ImagePreviewMode}"
				ItemTemplate="{StaticResource EnumDisplayNameTemplate}"
				SelectedItem="{x:Bind settings.ImagePreviewMode, Mode=TwoWay}"
			/>
		</StackPanel>

		<!--
		TODO: find a way to make the are around the image be a solid color without
		moving the canvas into the scrollview and making it scale with the image.
		-->
		<Grid Grid.Row="1">
			<canvas:CanvasControl Draw="CanvasControl_Draw" />

			<ScrollView
				x:Name="ScrollView"
				ZoomMode="Enabled"
				IsTabStop="True"
				HorizontalScrollMode="Auto"
				HorizontalScrollBarVisibility="Auto"
				VerticalScrollMode="Auto"
				VerticalScrollBarVisibility="Auto"
				CornerRadius="0"
			>
				<Image x:Name="TextureImage" />
			</ScrollView>

			<ProgressBar
				Visibility="{x:Bind viewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
				IsIndeterminate="True"
				VerticalAlignment="Top"
			/>
		</Grid>
	</Grid>
</Page>
