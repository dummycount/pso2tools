<?xml version="1.0" encoding="utf-8"?>
<Page
	x:Class="Pso2Tools.Defrost.Views.Preview.PreviewPageAqp"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Pso2Tools.Defrost.Views.Preview"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:hx="using:HelixToolkit.WinUI.SharpDX"
	mc:Ignorable="d"
>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>

		<StackPanel
			Orientation="Horizontal"
			Spacing="8"
			Padding="8"
			BorderThickness="0,0,0,1"
			BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
		>
			<ToggleButton
				IsChecked="{x:Bind viewModel.ShowGrid, Mode=TwoWay}"
				ToolTipService.ToolTip="Show grid"
			>
				<FontIcon Glyph="&#xF0E2;" />
			</ToggleButton>
			<ToggleButton
				IsChecked="{x:Bind viewModel.ShowAxis, Mode=TwoWay}"
				ToolTipService.ToolTip="Show axis"
			>
				<FontIcon Glyph="&#xF158;" />
			</ToggleButton>
		</StackPanel>

		<Grid Grid.Row="1">
			<hx:Viewport3DX
				x:Name="Viewport"
				BackgroundColor="#3f3f3f"
				Camera="{x:Bind viewModel.Camera}"
				EffectsManager="{x:Bind viewModel.EffectsManager, Mode=OneWay}"
				IsViewCubeEdgeClicksEnabled="True"
				FXAALevel="{x:Bind settings.ModelPreviewFXAALevel, Mode=OneWay}"
				FixedRotationPoint="{x:Bind viewModel.ModelCentroid, Mode=OneWay}"
				FixedRotationPointEnabled="True"
				CameraRotationMode="Turntable"
			>
				<hx:AmbientLight3D Color="#101010" />
				<hx:DirectionalLight3D
					Direction="{x:Bind viewModel.Camera.CameraInternal.LookDirection, Mode=OneWay}"
					Color="#efefef"
				/>

				<hx:LineGeometryModel3D
					Geometry="{x:Bind viewModel.Axis, Mode=OneWay}"
					IsRendering="{x:Bind viewModel.ShowAxis, Mode=OneWay}"
					IsHitTestVisible="False"
					Thickness="0.5"
					Color="White"
				/>

				<hx:AxisPlaneGridModel3D
					IsRendering="{x:Bind viewModel.ShowGrid, Mode=OneWay}"
					IsHitTestVisible="False"
					AutoSpacing="False"
					GridSpacing="0.5"
					GridThickness="0.01"
					GridPattern="Grid"
					FadingFactor="0.7"
					PlaneColor="Transparent"
				/>

				<hx:Element3DPresenter Content="{x:Bind viewModel.Root, Mode=OneWay}" />

				<hx:PostEffectMeshBorderHighlight EffectName="highlight" />
			</hx:Viewport3DX>

			<ProgressRing IsActive="{x:Bind viewModel.LoadModelCommand.IsRunning, Mode=OneWay}" />
		</Grid>
	</Grid>
</Page>
