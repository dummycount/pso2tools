<?xml version="1.0" encoding="utf-8"?>
<Page
	x:Class="Pso2Tools.Defrost.Views.Preview.PreviewPageAqp"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Pso2Tools.Defrost.Views.Preview"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:hx="using:HelixToolkit.WinUI.SharpDX"
	xmlns:controls="using:CommunityToolkit.WinUI.Controls"
	mc:Ignorable="d"
>
	<Grid SizeChanged="Grid_SizeChanged">
		<VisualStateManager.VisualStateGroups>
			<VisualStateGroup>
				<VisualState x:Name="Collapsed">
					<VisualState.Setters>
						<Setter Target="MainColorSeparator.Visibility" Value="Collapsed" />
						<Setter Target="RedColor.Visibility" Value="Collapsed" />
						<Setter Target="GreenColor.Visibility" Value="Collapsed" />
						<Setter Target="BlueColor.Visibility" Value="Collapsed" />
						<Setter Target="AlphaColor.Visibility" Value="Collapsed" />
						<Setter Target="SkinColor.Visibility" Value="Collapsed" />
						<Setter Target="SubSkinColor.Visibility" Value="Collapsed" />
					</VisualState.Setters>
				</VisualState>
				<VisualState x:Name="Expanded">
					<VisualState.Setters>
						<Setter Target="SkinColorSeparator.Visibility" Value="Collapsed" />
						<Setter Target="SkinColor.Visibility" Value="Collapsed" />
						<Setter Target="SubSkinColor.Visibility" Value="Collapsed" />
					</VisualState.Setters>
				</VisualState>
				<VisualState x:Name="Expanded2" />
			</VisualStateGroup>
		</VisualStateManager.VisualStateGroups>

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>

		<StackPanel
			Orientation="Horizontal"
			Spacing="8"
			Padding="8"
			BorderThickness="0,0,0,1"
			BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
		>
			<Button
				Command="{x:Bind viewModel.ResetCameraCommand}"
				ToolTipService.ToolTip="Reset camera"
			>
				<FontIcon Glyph="&#xE714;" />
			</Button>
			<ToggleButton
				IsChecked="{x:Bind viewModel.ShowGrid, Mode=TwoWay}"
				ToolTipService.ToolTip="Show grid"
			>
				<FontIcon Glyph="&#xF0E2;" />
			</ToggleButton>

			<ToggleButton
				IsChecked="{x:Bind viewModel.ShowAxes, Mode=TwoWay}"
				ToolTipService.ToolTip="Show axes"
			>
				<FontIcon Glyph="&#xF158;" />
			</ToggleButton>
			<ToggleButton
				IsChecked="{x:Bind viewModel.ShowWireframe, Mode=TwoWay}"
				ToolTipService.ToolTip="Show wireframe"
			>
				<FontIcon Glyph="&#xE774;" />
			</ToggleButton>

			<AppBarSeparator
				x:Name="MainColorSeparator"
				Visibility="{x:Bind viewModel.MainUsedChannels.Any, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
			/>

			<controls:ColorPickerButton
				x:Name="RedColor"
				ToolTipService.ToolTip="Red channel color"
				SelectedColor="{x:Bind viewModel.RedColor, Mode=TwoWay}"
				ColorPickerStyle="{StaticResource ColorPickerStyle}"
				Visibility="{x:Bind viewModel.MainUsedChannels.R, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
			/>
			<controls:ColorPickerButton
				x:Name="GreenColor"
				ToolTipService.ToolTip="Green channel color"
				SelectedColor="{x:Bind viewModel.GreenColor, Mode=TwoWay}"
				ColorPickerStyle="{StaticResource ColorPickerStyle}"
				Visibility="{x:Bind viewModel.MainUsedChannels.G, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
			/>
			<controls:ColorPickerButton
				x:Name="BlueColor"
				ToolTipService.ToolTip="Blue channel color"
				SelectedColor="{x:Bind viewModel.BlueColor, Mode=TwoWay}"
				ColorPickerStyle="{StaticResource ColorPickerStyle}"
				Visibility="{x:Bind viewModel.MainUsedChannels.B, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
			/>
			<controls:ColorPickerButton
				x:Name="AlphaColor"
				ToolTipService.ToolTip="Alpha channel color"
				SelectedColor="{x:Bind viewModel.AlphaColor, Mode=TwoWay}"
				ColorPickerStyle="{StaticResource ColorPickerStyle}"
				Visibility="{x:Bind viewModel.MainUsedChannels.A, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
			/>

			<AppBarSeparator
				x:Name="SkinColorSeparator"
				Visibility="{x:Bind viewModel.SkinUsedChannels.Any, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
			/>

			<controls:ColorPickerButton
				x:Name="SkinColor"
				ToolTipService.ToolTip="Main skin color"
				SelectedColor="{x:Bind viewModel.SkinColor, Mode=TwoWay}"
				ColorPickerStyle="{StaticResource ColorPickerStyle}"
				Visibility="{x:Bind viewModel.SkinUsedChannels.R, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
			/>
			<controls:ColorPickerButton
				x:Name="SubSkinColor"
				ToolTipService.ToolTip="Sub skin color"
				SelectedColor="{x:Bind viewModel.SubSkinColor, Mode=TwoWay}"
				ColorPickerStyle="{StaticResource ColorPickerStyle}"
				Visibility="{x:Bind viewModel.SkinUsedChannels.G, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
			/>
		</StackPanel>

		<Grid Grid.Row="1">
			<hx:Viewport3DX
				x:Name="Viewport"
				BackgroundColor="#3f3f3f"
				Camera="{x:Bind viewModel.Camera}"
				EffectsManager="{x:Bind viewModel.EffectsManager, Mode=OneWay}"
				IsViewCubeEdgeClicksEnabled="True"
				FXAALevel="{x:Bind settings.ModelPreviewFXAALevel, Mode=OneWay}"
				FixedRotationPoint="{x:Bind viewModel.ModelCentroid, Mode=OneWay}"
				FixedRotationPointEnabled="True"
				CameraRotationMode="Turntable"
			>
				<hx:AmbientLight3D Color="#202020" />
				<hx:DirectionalLight3D
					Direction="{x:Bind viewModel.Camera.CameraInternal.LookDirection, Mode=OneWay}"
					Color="#dfdfdf"
				/>

				<hx:LineGeometryModel3D
					Geometry="{x:Bind viewModel.Axes, Mode=OneWay}"
					IsRendering="{x:Bind viewModel.ShowAxes, Mode=OneWay}"
					IsHitTestVisible="False"
					Thickness="0.5"
					Color="White"
				/>

				<hx:AxisPlaneGridModel3D
					IsRendering="{x:Bind viewModel.ShowGrid, Mode=OneWay}"
					IsHitTestVisible="False"
					AutoSpacing="False"
					GridSpacing="0.5"
					GridThickness="0.02"
					GridPattern="Grid"
					FadingFactor="0.7"
					PlaneColor="Transparent"
				/>

				<hx:Element3DPresenter Content="{x:Bind viewModel.Root, Mode=OneWay}" />

				<hx:PostEffectMeshBorderHighlight EffectName="highlight" />
			</hx:Viewport3DX>

			<ProgressRing
				IsActive="{x:Bind viewModel.LoadModelCommand.IsRunning, Mode=OneWay}"
				Visibility="{x:Bind viewModel.LoadModelCommand.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
			/>
		</Grid>
	</Grid>
</Page>
