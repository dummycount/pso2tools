<?xml version="1.0" encoding="utf-8"?>
<Page
	x:Class="Pso2Tools.Defrost.Views.ExtractPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Pso2Tools.Defrost.Views"
	xmlns:defrost="using:Pso2Tools.Defrost"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:controls="using:CommunityToolkit.WinUI.Controls"
	xmlns:ui="using:CommunityToolkit.WinUI"
	mc:Ignorable="d"
>
	<Grid Background="{ThemeResource LayerFillColorAltBrush}">
		<VisualStateManager.VisualStateGroups>
			<VisualStateGroup x:Name="DialogStates">
				<VisualState x:Name="Normal" />
				<VisualState x:Name="Extracting">
					<VisualState.Setters>
						<Setter Target="Confirm.Visibility" Value="Collapsed" />
						<Setter Target="Settings.Visibility" Value="Collapsed" />
						<Setter Target="Progress.Visibility" Value="Visible" />
					</VisualState.Setters>
				</VisualState>
			</VisualStateGroup>
			<VisualStateGroup x:Name="ButtonStates">
				<VisualState x:Name="CancelEnabled" />
				<VisualState x:Name="CancelDisabled">
					<VisualState.Setters>
						<Setter Target="Cancel.IsEnabled" Value="False" />
					</VisualState.Setters>
				</VisualState>
			</VisualStateGroup>
		</VisualStateManager.VisualStateGroups>

		<Grid.RowDefinitions>
			<!-- Title -->
			<RowDefinition Height="Auto" />
			<!-- Settings -->
			<RowDefinition Height="*" />
			<!-- Buttons -->
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<TitleBar Title="{x:Bind viewModel.Title, Mode=OneWay}" IsTabStop="False">
			<TitleBar.IconSource>
				<FontIconSource Glyph="&#xF158;" />
			</TitleBar.IconSource>
		</TitleBar>

		<StackPanel Grid.Row="1" x:Name="Settings" Padding="24,12,24,24" Spacing="16">
			<Grid ColumnSpacing="8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<controls:HeaderedContentControl
					Header="Files will be extracted to this folder"
					HorizontalContentAlignment="Stretch"
					Style="{StaticResource HeaderedFieldStyle}"
				>
					<TextBox Text="{x:Bind viewModel.DestinationPath, Mode=TwoWay}" />
				</controls:HeaderedContentControl>

				<Button
					Grid.Column="1"
					x:Name="PickDestPath"
					Content="Browse..."
					VerticalAlignment="Bottom"
					Click="PickDestPath_Click"
				/>
			</Grid>

			<controls:HeaderedContentControl
				Header="If a file with the same name exists"
				Style="{StaticResource HeaderedFieldStyle}"
			>
				<ComboBox
					ItemsSource="{ui:EnumValues Type=defrost:CollisionOption}"
					ItemTemplate="{StaticResource EnumDisplayNameTemplate}"
					SelectedItem="{x:Bind viewModel.CollisionOption, Mode=TwoWay}"
				/>
			</controls:HeaderedContentControl>

			<CheckBox
				Grid.Row="1"
				Content="Use &quot;group1&quot; and &quot;group2&quot; folders"
				IsChecked="{x:Bind viewModel.UseGroupFolders, Mode=TwoWay}"
				IsEnabled="{x:Bind viewModel.IsGroupFoldersEnabled, Mode=OneWay}"
			/>
			<CheckBox
				Grid.Row="2"
				Content="Open folder after extracting"
				IsChecked="{x:Bind viewModel.OpenFolderWhenDone, Mode=TwoWay}"
			/>
		</StackPanel>

		<StackPanel
			Grid.Row="1"
			x:Name="Progress"
			Padding="24,12,24,24"
			Spacing="16"
			Visibility="Collapsed"
		>
			<TextBlock Text="{x:Bind viewModel.ExtractingFile, Mode=OneWay}" />
			<TextBlock>
				File
				<Run Text="{x:Bind viewModel.CurrentFileIndex, Mode=OneWay}" />
				of
				<Run Text="{x:Bind viewModel.TotalFileCount, Mode=OneWay}" />
			</TextBlock>
			<ProgressBar Value="{x:Bind viewModel.ProgressPercent, Mode=OneWay}" />
		</StackPanel>

		<Grid
			Grid.Row="2"
			Padding="24"
			ColumnSpacing="8"
			VerticalAlignment="Bottom"
			XYFocusKeyboardNavigation="Enabled"
			Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
		>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<Button
				Grid.Column="1"
				x:Name="Confirm"
				Content="Extract"
				MinWidth="100"
				Click="Confirm_Click"
				IsEnabled="{x:Bind viewModel.IsDestinationValid, Mode=OneWay}"
			/>
			<Button
				Grid.Column="2"
				x:Name="Cancel"
				Content="Cancel"
				MinWidth="100"
				Click="Cancel_Click"
			/>
		</Grid>
	</Grid>
</Page>
