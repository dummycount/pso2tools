<?xml version="1.0" encoding="utf-8"?>
<Page
	x:Class="Pso2Tools.Defrost.Views.SettingsPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Pso2Tools.Defrost.Views"
	xmlns:defrost="using:Pso2Tools.Defrost"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:ui="using:CommunityToolkit.WinUI"
	xmlns:controls="using:CommunityToolkit.WinUI.Controls"
	xmlns:converters="using:CommunityToolkit.WinUI.Converters"
	mc:Ignorable="d"
>
	<Page.Resources>
		<Style
			x:Key="SettingsSectionHeaderTextBlockStyle"
			BasedOn="{StaticResource BodyStrongTextBlockStyle}"
			TargetType="TextBlock"
		>
			<Style.Setters>
				<Setter Property="Margin" Value="1,30,0,6" />
			</Style.Setters>
		</Style>
	</Page.Resources>

	<Grid x:Name="RootGrid">
		<Grid.RowDefinitions>
			<!-- Settings -->
			<RowDefinition Height="*" />
			<!-- Buttons -->
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
			<ScrollView
				IsTabStop="False"
				Padding="36,0,36,0"
				VerticalScrollBarVisibility="Auto"
				VerticalScrollMode="Auto"
			>
				<Border>
					<StackPanel MaxWidth="1064" Spacing="4" Margin="0,0,0,36">
						<!--<StackPanel.ChildrenTransitions>
							<RepositionThemeTransition />
						</StackPanel.ChildrenTransitions>-->

						<TextBlock
							Text="Appearance &amp; behavior"
							Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
						/>

						<controls:SettingsCard Header="Theme">
							<controls:SettingsCard.HeaderIcon>
								<FontIcon Glyph="&#xE790;" />
							</controls:SettingsCard.HeaderIcon>

							<ComboBox
								x:Name="ThemeMode"
								SelectionChanged="ThemeMode_SelectionChanged"
							>
								<ComboBoxItem Content="Use system setting" Tag="Default" />
								<ComboBoxItem Content="Light" Tag="Light" />
								<ComboBoxItem Content="Dark" Tag="Dark" />
							</ComboBox>
						</controls:SettingsCard>

						<controls:SettingsCard
							Header="Default extract location"
							Description="{x:Bind viewModel.CustomExtractFolderDescription, Mode=OneWay}"
						>
							<controls:SettingsCard.HeaderIcon>
								<FontIcon Glyph="&#xE80F;" />
							</controls:SettingsCard.HeaderIcon>

							<StackPanel Orientation="Horizontal" Spacing="8">
								<Button
									x:Name="CustomExtractFolderBuffon"
									Content="Select folder"
									Click="CustomExtractFolderBuffon_Click"
									MinWidth="120"
									Visibility="{x:Bind viewModel.IsCustomExtractFolderVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
								/>

								<ComboBox
									ItemsSource="{ui:EnumValues Type=defrost:DefaultExtractLocation}"
									ItemTemplate="{StaticResource EnumDisplayNameTemplate}"
									SelectedItem="{x:Bind settings.DefaultExtractLocation, Mode=TwoWay}"
								/>
							</StackPanel>
						</controls:SettingsCard>

						<controls:SettingsCard
							Header="Use &quot;group1&quot; and &quot;group2&quot; folders"
							Description="Group files into subfolders when extracting"
						>
							<controls:SettingsCard.HeaderIcon>
								<FontIcon Glyph="&#xE8F4;" />
							</controls:SettingsCard.HeaderIcon>

							<ComboBox
								ItemsSource="{ui:EnumValues Type=defrost:ExtractGroupMode}"
								ItemTemplate="{StaticResource EnumDisplayNameTemplate}"
								SelectedItem="{x:Bind settings.ExtractGroupMode, Mode=TwoWay}"
							/>
						</controls:SettingsCard>

						<TextBlock
							Text="File associations"
							Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
						/>

						<controls:SettingsCard
							x:Name="RegisterProtocolButton"
							Header="Open Defrost with pso2defrost:// links"
							Description="{x:Bind viewModel.ProtocolRegisterStatus, Mode=OneWay}"
							IsClickEnabled="True"
							Click="RegisterProtocolButton_Click"
						>
							<controls:SettingsCard.HeaderIcon>
								<FontIcon Glyph="&#xE71B;" />
							</controls:SettingsCard.HeaderIcon>

							<TextBlock Text="{x:Bind viewModel.ProtocolRegisterAction, Mode=OneWay}" />
						</controls:SettingsCard>

						<TextBlock
							Text="About"
							Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
						/>

						<controls:SettingsExpander Header="Defrost">
							<controls:SettingsExpander.HeaderIcon>
								<FontIcon Glyph="&#xF158;" />
							</controls:SettingsExpander.HeaderIcon>

							<TextBlock
								Foreground="{ThemeResource TextFillColorSecondaryBrush}"
								IsTextSelectionEnabled="True"
								Text="{x:Bind viewModel.Version}"
							/>

							<controls:SettingsExpander.Items>
								<controls:SettingsCard
									x:Name="OpenRepoCard"
									Header="Open GitHub repository"
									IsClickEnabled="True"
									Click="OpenRepoCard_Click"
								>
									<TextBlock>https://github.com/dummycount/pso2tools</TextBlock>
									<controls:SettingsCard.ActionIcon>
										<FontIcon Glyph="&#xE8C8;" />
									</controls:SettingsCard.ActionIcon>
								</controls:SettingsCard>

								<controls:SettingsCard
									Header="Portions of this software are based on code from the following projects"
									ContentAlignment="Vertical"
									HorizontalContentAlignment="Left"
								>
									<StackPanel Margin="-12,0,0,0">
										<HyperlinkButton
											Content="PSO2 Aqua Library"
											NavigateUri="https://github.com/Shadowth117/PSO2-Aqua-Library"
										/>
										<HyperlinkButton
											Content="WinUI 3"
											NavigateUri="https://aka.ms/winui"
										/>
										<HyperlinkButton
											Content="WinUI 3 Gallery"
											NavigateUri="https://github.com/microsoft/WinUI-Gallery"
										/>
										<HyperlinkButton
											Content="Windows Community Toolkit"
											NavigateUri="https://aka.ms/toolkit/windows"
										/>
									</StackPanel>
								</controls:SettingsCard>
							</controls:SettingsExpander.Items>
						</controls:SettingsExpander>
					</StackPanel>
				</Border>
			</ScrollView>
		</Grid>

		<Grid
			Grid.Row="1"
			Padding="24"
			ColumnSpacing="8"
			VerticalAlignment="Bottom"
			XYFocusKeyboardNavigation="Enabled"
			Background="{ThemeResource LayerFillColorAltBrush}"
		>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<Button
				Grid.Column="1"
				x:Name="Close"
				Content="Back"
				MinWidth="100"
				Click="Close_Click"
			/>
		</Grid>
	</Grid>
</Page>
