<?xml version="1.0" encoding="utf-8"?>
<Page
	x:Class="Pso2Tools.Defrost.Views.MainPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Pso2Tools.Defrost.Views"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:sys="using:System"
	xmlns:controls="using:Pso2Tools.Defrost.Controls"
	xmlns:viewmodels="using:Pso2Tools.Defrost.ViewModels"
	xmlns:converters="using:CommunityToolkit.WinUI.Converters"
	xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
	mc:Ignorable="d"
	AllowDrop="True"
	Drop="Page_Drop"
	DragEnter="Page_DragEnter"
>
	<Page.Resources>
		<converters:SwitchConverter x:Key="CountToItemsConverter" TargetType="sys:Int32">
			<toolkit:Case Value="1" Content="item" />
			<toolkit:Case IsDefault="True" Content="items" />
		</converters:SwitchConverter>

		<!-- Right click context menu for the file list -->
		<MenuFlyout x:Name="FileItemFlyout" Placement="Right">
			<MenuFlyoutItem x:Name="ContextMenuCopy" Text="Copy" Click="ContextMenuCopy_Click">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE8C8;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
			<!-- TODO: add more options like export, make them conditional on the type of file -->
		</MenuFlyout>
	</Page.Resources>

	<Grid>
		<VisualStateManager.VisualStateGroups>
			<VisualStateGroup>
				<VisualState>
					<VisualState.StateTriggers>
						<AdaptiveTrigger MinWindowWidth="600" />
					</VisualState.StateTriggers>
					<VisualState.Setters>
						<Setter Target="ShowPreviewPanel.Visibility" Value="Visible" />
						<Setter Target="PreviewPanelWrap.Visibility" Value="Visible" />
					</VisualState.Setters>
				</VisualState>
			</VisualStateGroup>

			<VisualStateGroup x:Name="PanelStates">
				<VisualState x:Name="PanelClosed">
					<VisualState.Setters>
						<Setter Target="FileListColumn.Width" Value="*" />
						<Setter Target="PreviewPanelColumn.Width" Value="Auto" />
						<Setter Target="PreviewPanel.Visibility" Value="Collapsed" />
					</VisualState.Setters>
				</VisualState>
				<VisualState x:Name="PanelOpen">
					<VisualState.Setters>
						<Setter Target="FileListColumn.Width" Value="Auto" />
						<Setter Target="PreviewPanelColumn.Width" Value="*" />
						<Setter Target="PreviewPanel.Visibility" Value="Visible" />
					</VisualState.Setters>
				</VisualState>
			</VisualStateGroup>
		</VisualStateManager.VisualStateGroups>

		<Grid.RowDefinitions>
			<!--  CommandBar  -->
			<RowDefinition Height="Auto" />
			<!-- Content -->
			<RowDefinition Height="*" />
			<!-- Status bar -->
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid
			Background="{ThemeResource LayerOnMicaBaseAltFillColorSecondaryBrush}"
			BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
			BorderThickness="0,0,0,1"
			Padding="8,0,0,0"
		>
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Left">
				<AppBarButton
					Icon="OpenLocal"
					Label="Open"
					Command="{x:Bind viewModel.OpenCommand}"
				>
					<Button.KeyboardAccelerators>
						<KeyboardAccelerator Modifiers="Control" Key="O" />
					</Button.KeyboardAccelerators>
				</AppBarButton>

				<AppBarButton
					x:Name="Extract"
					Icon="MoveToFolder"
					Label="Extract all"
					Click="Extract_Click"
					IsEnabled="{x:Bind viewModel.Archive, Mode=OneWay, Converter={StaticResource NotNullToBoolConverter}}"
				>
					<Button.KeyboardAccelerators>
						<KeyboardAccelerator Modifiers="Control" Key="E" />
					</Button.KeyboardAccelerators>
				</AppBarButton>

				<AppBarButton
					x:Name="Copy"
					Icon="Copy"
					Label="Copy"
					Click="Copy_Click"
					IsEnabled="{x:Bind viewModel.HasSelection, Mode=OneWay}"
				>
					<Button.KeyboardAccelerators>
						<KeyboardAccelerator Modifiers="Control" Key="C" />
					</Button.KeyboardAccelerators>
				</AppBarButton>
			</CommandBar>

			<CommandBar Grid.Column="1" DefaultLabelPosition="Collapsed">
				<AppBarButton
					x:Name="ShowPreviewPanel"
					Visibility="Collapsed"
					Icon="DockRight"
					Label="Show/hide preview panel"
					ToolTipService.ToolTip="Show/hide preview panel"
					Click="ShowPreviewPanel_Click"
				/>

				<AppBarButton
					x:Name="Settings"
					Icon="Setting"
					Label="Settings"
					Click="Settings_Click"
					ToolTipService.ToolTip="Settings"
				/>
			</CommandBar>
		</Grid>

		<!-- TODO: add right click menu on items -->

		<Grid Grid.Row="1" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition x:Name="FileListColumn" />
				<ColumnDefinition x:Name="PreviewPanelColumn" Width="Auto" />
			</Grid.ColumnDefinitions>

			<controls:DataTable CellPadding="12,0,20,0">
				<controls:DataTable.Header>
					<controls:DataTableHeader Margin="12,0">
						<controls:DataColumn Content="Name" MinWidth="220" />
						<controls:DataColumn Content="Size" MinWidth="90" />
						<controls:DataColumn Content="Group" BorderThickness="0" />
					</controls:DataTableHeader>
				</controls:DataTable.Header>

				<ItemsView
					x:Name="FileList"
					ItemsSource="{x:Bind viewModel.Files, Mode=OneWay}"
					Padding="12,4,12,20"
					SelectionMode="Extended"
					SelectionChanged="FileList_SelectionChanged"
					IsItemInvokedEnabled="True"
					ItemInvoked="FileList_ItemInvoked"
					PointerPressed="FileList_PointerPressed"
				>
					<ItemsView.Layout>
						<StackLayout Spacing="4" />
					</ItemsView.Layout>

					<ItemsView.ItemTemplate>
						<DataTemplate x:DataType="viewmodels:IceFileModel">
							<ItemContainer
								Tag="{x:Bind}"
								Style="{StaticResource FileListItemContainer}"
								Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
								AutomationProperties.Name="{x:Bind Name}"
								CanDrag="True"
								DragStarting="Item_DragStarting"
								PointerPressed="Item_PointerPressed"
								ContextRequested="Item_ContextRequested"
							>
								<controls:DataRow Margin="0" Height="28">
									<TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
									<TextBlock
										Text="{x:Bind SizeText}"
										VerticalAlignment="Center"
										HorizontalAlignment="Right"
									/>
									<TextBlock Text="{x:Bind Group}" VerticalAlignment="Center" />
								</controls:DataRow>
							</ItemContainer>
						</DataTemplate>
					</ItemsView.ItemTemplate>
				</ItemsView>
			</controls:DataTable>

			<Grid Grid.Column="1" x:Name="PreviewPanelWrap" Visibility="Collapsed">
				<Border
					x:Name="PreviewPanel"
					Visibility="Collapsed"
					BorderThickness="1,0,0,0"
					BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
				>
					<Frame x:Name="PreviewFrame" />
				</Border>
			</Grid>
		</Grid>

		<ProgressRing
			Grid.Row="1"
			IsActive="{x:Bind viewModel.IsLoading, Mode=OneWay}"
			Visibility="{x:Bind viewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
		/>

		<Border
			Grid.Row="2"
			Height="32"
			BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
			BorderThickness="0,1,0,0"
			Padding="24,6"
		>
			<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
				<TextBlock>
					<Run Text="{x:Bind viewModel.Files.Count, Mode=OneWay}" />
					<Run Text="{x:Bind viewModel.Files.Count, Mode=OneWay, Converter={StaticResource CountToItemsConverter}}" />
				</TextBlock>

				<Border
					BorderThickness="1,0,0,0"
					BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
					Visibility="{x:Bind viewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
				/>

				<TextBlock Visibility="{x:Bind viewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
					<Run Text="{x:Bind viewModel.SelectedCount, Mode=OneWay}" />
					<Run Text="{x:Bind viewModel.SelectedCount, Mode=OneWay, Converter={StaticResource CountToItemsConverter}}" />
					<Run Text="selected" />
				</TextBlock>

				<Border
					BorderThickness="1,0,0,0"
					BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
					Visibility="{x:Bind viewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
				/>

				<TextBlock
					Visibility="{x:Bind viewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
					Text="{x:Bind viewModel.SelectedTotalFileSize, Mode=OneWay, Converter={StaticResource FileSizeConverter}}"
				/>
			</StackPanel>
		</Border>
	</Grid>
</Page>
