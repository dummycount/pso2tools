<?xml version="1.0" encoding="utf-8"?>
<Page
	x:Class="Pso2Tools.Defrost.Views.MainPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Pso2Tools.Defrost.Views"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:sys="using:System"
	xmlns:viewmodels="using:Pso2Tools.Defrost.ViewModels"
	xmlns:tv="using:WinUI.TableView"
	xmlns:controls="using:CommunityToolkit.WinUI.Controls"
	xmlns:converters="using:CommunityToolkit.WinUI.Converters"
	mc:Ignorable="d"
	AllowDrop="True"
	Drop="Page_Drop"
	DragEnter="Page_DragEnter"
>
	<Page.Resources>
		<converters:SwitchConverter x:Key="CountToItemsConverter" TargetType="sys:Int32">
			<controls:Case Value="1" Content="item" />
			<controls:Case IsDefault="True" Content="items" />
		</converters:SwitchConverter>
	</Page.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<!--  CommandBar  -->
			<RowDefinition Height="Auto" />
			<!-- Content -->
			<RowDefinition Height="*" />
			<!-- Status bar -->
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid
			Background="{ThemeResource LayerOnMicaBaseAltFillColorSecondaryBrush}"
			BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
			BorderThickness="0,0,0,1"
			Padding="8,0,0,0"
		>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Left">
				<AppBarButton
					Icon="OpenLocal"
					Label="Open"
					Command="{x:Bind viewModel.OpenCommand}"
				>
					<Button.KeyboardAccelerators>
						<KeyboardAccelerator Modifiers="Control" Key="O" />
					</Button.KeyboardAccelerators>
				</AppBarButton>

				<AppBarButton
					x:Name="Extract"
					Icon="MoveToFolder"
					Label="Extract all"
					Click="Extract_Click"
					IsEnabled="{x:Bind viewModel.Archive, Mode=OneWay, Converter={StaticResource NotNullToBoolConverter}}"
				>
					<Button.KeyboardAccelerators>
						<KeyboardAccelerator Modifiers="Control" Key="E" />
					</Button.KeyboardAccelerators>
				</AppBarButton>

				<AppBarButton
					x:Name="Copy"
					Icon="Copy"
					Label="Copy"
					Click="Copy_Click"
					IsEnabled="{x:Bind viewModel.HasSelection, Mode=OneWay}"
				>
					<Button.KeyboardAccelerators>
						<KeyboardAccelerator Modifiers="Control" Key="C" />
					</Button.KeyboardAccelerators>
				</AppBarButton>
			</CommandBar>

			<CommandBar Grid.Column="1" DefaultLabelPosition="Collapsed">
				<AppBarButton Icon="Setting" Label="Settings" />
			</CommandBar>
		</Grid>

		<!-- TODO: add right click menu on items -->

		<!--
		TODO: there's some element that shows up on the left of the header and then
		disappears once data is loaded, shifting everything over to the left.
		-->
		<tv:TableView
			Grid.Row="1"
			x:Name="FileList"
			AutoGenerateColumns="False"
			ItemsSource="{x:Bind viewModel.Files, Mode=OneWay}"
			Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
			BorderThickness="0"
			CornerRadius="0"
			Padding="9,2,4,0"
			RowMinHeight="36"
			HeaderRowHeight="32"
			HeaderRowMinHeight="32"
			GridLinesVisibility="None"
			HeaderGridLinesVisibility="Vertical"
			HeadersVisibility="Columns"
			IsReadOnly="True"
			CanDragItems="True"
			CanReorderColumns="False"
			CanResizeColumns="False"
			CornerButtonMode="None"
			SelectionMode="Extended"
			SelectionUnit="Row"
			SelectionChanged="FileList_SelectionChanged"
			DragItemsStarting="FileList_DragItemsStarting"
		>
			<tv:TableView.Columns>
				<tv:TableViewTextColumn Header="Name" Binding="{Binding Name}" MinWidth="220" />
				<tv:TableViewNumberColumn
					Header="Size"
					Binding="{Binding Size, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:#,0}'}"
					MinWidth="90"
				/>
				<tv:TableViewNumberColumn Header="Group" Binding="{Binding Group}" />
			</tv:TableView.Columns>

			<tv:TableView.ColumnHeaderStyle>
				<Style TargetType="tv:TableViewColumnHeader">
					<Setter Property="FontWeight" Value="Normal" />
				</Style>
			</tv:TableView.ColumnHeaderStyle>

			<tv:TableView.ItemContainerStyle>
				<Style
					BasedOn="{StaticResource DefaultListViewItemStyle}"
					TargetType="ListViewItem"
				>
					<Setter Property="Padding" Value="0,0,12,0" />
					<Setter Property="MinHeight" Value="36" />
					<Setter Property="Height" Value="36" />
				</Style>
			</tv:TableView.ItemContainerStyle>

			<tv:TableView.CellStyle>
				<Style TargetType="tv:TableViewCell">
					<Setter Property="Padding" Value="0" />
				</Style>
			</tv:TableView.CellStyle>
		</tv:TableView>

		<ProgressRing Grid.Row="1" IsActive="{x:Bind viewModel.IsLoading, Mode=OneWay}" />

		<Border
			Grid.Row="2"
			Height="32"
			BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
			BorderThickness="0,1,0,0"
			Padding="16,6"
		>
			<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
				<TextBlock>
					<Run Text="{x:Bind viewModel.Files.Count, Mode=OneWay}" />
					<Run Text="{x:Bind viewModel.Files.Count, Mode=OneWay, Converter={StaticResource CountToItemsConverter}}" />
				</TextBlock>

				<Border
					BorderThickness="1,0,0,0"
					BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
					Visibility="{x:Bind viewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
				/>

				<TextBlock Visibility="{x:Bind viewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
					<Run Text="{x:Bind viewModel.SelectedCount, Mode=OneWay}" />
					<Run Text="{x:Bind viewModel.SelectedCount, Mode=OneWay, Converter={StaticResource CountToItemsConverter}}" />
					<Run Text="selected" />
				</TextBlock>

				<Border
					BorderThickness="1,0,0,0"
					BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
					Visibility="{x:Bind viewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
				/>

				<TextBlock
					Visibility="{x:Bind viewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
					Text="{x:Bind viewModel.SelectedTotalFileSize, Mode=OneWay, Converter={StaticResource FileSizeConverter}}"
				/>
			</StackPanel>
		</Border>
	</Grid>
</Page>
