<?xml version="1.0" encoding="utf-8"?>
<Window
	x:Class="Pso2Tools.Defrost.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Pso2Tools.Defrost"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
	xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
	xmlns:controls="using:CommunityToolkit.WinUI.Controls"
	xmlns:viewmodels="using:Pso2Tools.Defrost.ViewModels"
	xmlns:tv="using:WinUI.TableView"
	mc:Ignorable="d"
	Title="Defrost"
>
	<Window.SystemBackdrop>
		<MicaBackdrop />
	</Window.SystemBackdrop>

	<Grid>
		<Grid.RowDefinitions>
			<!--  TitleBar  -->
			<RowDefinition Height="Auto" />
			<!--  CommandBar  -->
			<RowDefinition Height="Auto" />
			<!-- Content -->
			<RowDefinition Height="*" />
			<!-- Status bar -->
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<TitleBar x:Name="TitleBar" Title="Defrost" IsTabStop="False">
			<TitleBar.IconSource>
				<FontIconSource Glyph="&#xF158;" />
			</TitleBar.IconSource>
		</TitleBar>

		<Grid Grid.Row="1" Padding="6,4,8,8" ColumnSpacing="8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<Grid.Resources>
				<Style TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
					<Setter Property="Padding" Value="7" />
					<Setter Property="FontSize" Value="12" />
				</Style>
				<Style TargetType="FontIcon">
					<Setter Property="FontSize" Value="16" />
				</Style>
			</Grid.Resources>

			<!-- TODO: connect the open button to the text box/place it inside? -->
			<Button Command="{x:Bind viewModel.OpenCommand}">
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
					<FontIcon Glyph="&#xE8DA;" />
					<TextBlock Text="Open" />
				</StackPanel>
				<Button.KeyboardAccelerators>
					<KeyboardAccelerator Modifiers="Control" Key="O" />
				</Button.KeyboardAccelerators>
			</Button>

			<!-- TODO: allow entering a file path here and pressing enter to open? -->
			<!-- or should the path just be moved to the title bar? -->
			<TextBox
				Grid.Column="1"
				Height="32"
				IsReadOnly="True"
				Text="{x:Bind viewModel.FilePath, Mode=OneWay}"
				Style="{StaticResource DefaultTextBoxStyle}"
				TextChanged="TextBox_TextChanged"
				BorderThickness="0"
				Padding="10,6,10,6"
			/>

			<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
				<Button>
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
						<FontIcon Glyph="&#xE8DE;" />
						<TextBlock Text="Extract" />
					</StackPanel>
					<Button.KeyboardAccelerators>
						<KeyboardAccelerator Modifiers="Control" Key="E" />
					</Button.KeyboardAccelerators>
				</Button>

				<Button>
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
						<FontIcon Glyph="&#xE8DE;" />
						<TextBlock Text="Copy" />
					</StackPanel>
					<Button.KeyboardAccelerators>
						<KeyboardAccelerator Modifiers="Control" Key="C" />
					</Button.KeyboardAccelerators>
				</Button>

				<Button ToolTipService.ToolTip="Settings">
					<FontIcon Glyph="&#xE713;" />
				</Button>
			</StackPanel>
		</Grid>

		<!-- TODO: add right click menu on items -->

		<!--
		TODO: there's some element that shows up on the left of the header and then
		disappears once data is loaded, shifting everything over to the left.
		-->
		<tv:TableView
			Grid.Row="2"
			ItemsSource="{x:Bind viewModel.Files, Mode=OneWay}"
			AutoGenerateColumns="False"
			IsReadOnly="True"
			CornerButtonMode="None"
			GridLinesVisibility="None"
			HeaderGridLinesVisibility="Vertical"
			HeadersVisibility="Columns"
			SelectionUnit="Row"
			CanSortColumns="False"
			CanFilterColumns="False"
			CanReorderColumns="False"
			CanResizeColumns="False"
			BorderThickness="0,1,0,0"
			CornerRadius="0"
			Padding="0,2,0,0"
			RowMinHeight="36"
			HeaderRowHeight="26"
			HeaderRowMinHeight="26"
		>
			<tv:TableView.Columns>
				<tv:TableViewTextColumn Header="Name" Binding="{Binding Name}" MinWidth="180" />
				<tv:TableViewNumberColumn
					Header="Size"
					Binding="{Binding Size, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:#,0}'}"
					MinWidth="80"
				/>
			</tv:TableView.Columns>

			<tv:TableView.ColumnHeaderStyle>
				<Style TargetType="tv:TableViewColumnHeader">
					<Setter Property="FontWeight" Value="Normal" />
				</Style>
			</tv:TableView.ColumnHeaderStyle>

			<tv:TableView.ItemContainerStyle>
				<Style
					BasedOn="{StaticResource DefaultListViewItemStyle}"
					TargetType="ListViewItem"
				>
					<Setter Property="Padding" Value="-1,0,12,0" />
					<Setter Property="Margin" Value="10,0,8,0" />
					<Setter Property="MinHeight" Value="36" />
					<Setter Property="Height" Value="36" />
				</Style>
			</tv:TableView.ItemContainerStyle>

			<tv:TableView.CellStyle>
				<Style TargetType="tv:TableViewCell">
					<Setter Property="Padding" Value="0" />
				</Style>
			</tv:TableView.CellStyle>
		</tv:TableView>

		<InfoBar Grid.Row="2" HorizontalAlignment="Center">
			<interactivity:Interaction.Behaviors>
				<behaviors:StackedNotificationsBehavior x:Name="NotificationQueue" />
			</interactivity:Interaction.Behaviors>
		</InfoBar>

		<!-- TODO: display info about the selection here -->
		<Border
			Grid.Row="3"
			Height="32"
			BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
			BorderThickness="0,1,0,0"
		></Border>
	</Grid>
</Window>
