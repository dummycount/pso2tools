<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Pso2Tools.Defrost.Controls"
>
	<Style TargetType="local:DataTable" BasedOn="{StaticResource DefaultDataTableStyle}" />

	<Style x:Key="DefaultDataTableStyle" TargetType="local:DataTable">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="local:DataTable">
					<Grid
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="{TemplateBinding CornerRadius}"
					>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition />
						</Grid.RowDefinitions>

						<Grid>
							<ContentPresenter
								x:Name="HeaderPresenter"
								Content="{TemplateBinding Header}"
							/>
						</Grid>
						<ContentPresenter
							Grid.Row="1"
							x:Name="ContentPresenter"
							Content="{TemplateBinding Content}"
							Padding="{TemplateBinding Padding}"
						/>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="local:DataColumn" BasedOn="{StaticResource DefaultDataColumnStyle}" />

	<Style x:Key="DefaultDataColumnStyle" TargetType="local:DataColumn">
		<Setter Property="HorizontalContentAlignment" Value="Left" />
		<Setter Property="BorderThickness" Value="0,0,1,0" />
		<Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="local:DataColumn">
					<Grid
						Height="32"
						BorderThickness="{TemplateBinding BorderThickness}"
						BorderBrush="{TemplateBinding BorderBrush}"
					>
						<ContentPresenter
							Margin="{TemplateBinding Padding}"
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
						/>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="local:DataRow" BasedOn="{StaticResource DefaultDataRowStyle}" />

	<Style x:Key="DefaultDataRowStyle" TargetType="local:DataRow">
		<Setter Property="HorizontalAlignment" Value="Left" />
	</Style>
</ResourceDictionary>
