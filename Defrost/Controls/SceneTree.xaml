<?xml version="1.0" encoding="utf-8"?>
<UserControl
	x:Class="Pso2Tools.Defrost.Controls.SceneTree"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Pso2Tools.Defrost.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:scene="using:HelixToolkit.SharpDX.Model.Scene"
	xmlns:preview="using:Pso2Tools.Defrost.ViewModels.Preview"
	mc:Ignorable="d"
>
	<UserControl.Resources>
		<local:SceneNodeToIconConverter x:Key="SceneNodeToIconConverter" />
	</UserControl.Resources>

	<Grid>
		<Grid.Resources>
			<DataTemplate x:Key="NodeTemplate" x:DataType="scene:SceneNode">
				<TreeViewItem
					AutomationProperties.Name="{x:Bind Name}"
					ItemsSource="{x:Bind Items}"
					IsExpanded="{x:Bind ((preview:AttachedNodeViewModel)Tag).IsExpanded, Mode=TwoWay}"
				>
					<StackPanel Orientation="Horizontal" Spacing="8" Margin="-6,0,0,0">
						<FontIcon
							Glyph="{x:Bind Converter={StaticResource SceneNodeToIconConverter}}"
							FontSize="14"
						/>
						<TextBlock Text="{x:Bind Name}" />
					</StackPanel>
				</TreeViewItem>
			</DataTemplate>

			<local:SceneNodeTemplateSelector
				x:Key="TemplateSelector"
				DefaultTemplate="{StaticResource NodeTemplate}"
			/>
		</Grid.Resources>

		<TreeView
			x:Name="TreeView"
			ItemsSource="{x:Bind SceneRoot.Items, Mode=OneWay}"
			SelectedItem="{x:Bind SelectedItem, Mode=TwoWay}"
			ItemTemplateSelector="{StaticResource TemplateSelector}"
			SelectionMode="Single"
			CanDrag="False"
			CanDragItems="False"
			CanReorderItems="False"
			Loaded="TreeView_Loaded"
		/>
	</Grid>
</UserControl>
