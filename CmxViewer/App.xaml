<?xml version="1.0" encoding="utf-8"?>
<Application
	x:Class="Pso2Tools.CmxViewer.App"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Pso2Tools.CmxViewer"
	xmlns:controls="using:CommunityToolkit.WinUI.Controls"
	xmlns:collections="using:CommunityToolkit.WinUI.Collections"
	xmlns:ic="using:FluentIcons.WinUI"
>
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
				<!-- Other merged dictionaries here -->
			</ResourceDictionary.MergedDictionaries>

			<SolidColorBrush
				x:Key="AlternateRowColorBrush"
				Color="{ThemeResource LayerOnMicaBaseAltFillColorSecondary}"
			/>

			<local:ColorToBrushConverter x:Key="ColorToBrushConverter" />
			<local:EnumDisplayNameConverter x:Key="EnumDisplayNameConverter" />
			<local:SortDirectionIconConverter x:Key="SortDirectionIconConverter" />

			<DataTemplate x:Name="EnumDisplayNameTemplate">
				<TextBlock Text="{Binding Converter={StaticResource EnumDisplayNameConverter}}" />
			</DataTemplate>

			<DataTemplate x:Name="SortDirectionIconTemplate">
				<ic:SymbolIcon
					Symbol="{Binding Converter={StaticResource SortDirectionIconConverter}}"
					FontSize="16"
					Margin="2,2,2,1"
				>
					<ToolTipService.ToolTip>
						<ToolTip Content="{Binding Converter={StaticResource EnumDisplayNameConverter}}" />
					</ToolTipService.ToolTip>
				</ic:SymbolIcon>
			</DataTemplate>

			<Style x:Name="HeaderedFieldStyle" TargetType="controls:HeaderedContentControl">
				<Setter Property="HeaderTemplate">
					<Setter.Value>
						<DataTemplate>
							<TextBlock
								Text="{Binding}"
								Style="{StaticResource BodyStrongTextBlockStyle}"
								Margin="0,0,0,12"
							/>
						</DataTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</Application.Resources>
</Application>
