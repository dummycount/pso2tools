<?xml version="1.0" encoding="utf-8"?>
<Page
	x:Class="Pso2Tools.CmxViewer.Views.ColorSetsPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Pso2Tools.CmxViewer.Views"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	xmlns:pso="using:Pso2Tools"
	xmlns:cmx="using:Pso2Tools.CmxViewer"
	xmlns:cmxcontrols="using:Pso2Tools.CmxViewer.Controls"
	xmlns:ui="using:CommunityToolkit.WinUI"
	xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
	xmlns:controls="using:CommunityToolkit.WinUI.Controls"
	xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<TextBlock
			Text="Color Sets"
			Style="{StaticResource SubtitleTextBlockStyle}"
			Margin="36,24,36,16"
		/>

		<controls:WrapPanel
			Grid.Row="1"
			Orientation="Horizontal"
			VerticalAlignment="Bottom"
			HorizontalSpacing="24"
			VerticalSpacing="16"
			Margin="36,0,36,16"
		>
			<AutoSuggestBox
				VerticalAlignment="Bottom"
				Width="200"
				Text="{x:Bind viewModel.FilterText, Mode=TwoWay}"
				PlaceholderText="Search"
				QueryIcon="Find"
			/>

			<controls:HeaderedContentControl
				Header="Game version"
				Style="{StaticResource HeaderedFieldStyle}"
			>
				<controls:Segmented
					x:Name="GameVersion"
					ItemsSource="{ui:EnumValues Type=cmx:GameVersionFilter}"
					SelectedItem="{x:Bind viewModel.GameVersion, Mode=OneWay}"
					ItemTemplate="{StaticResource EnumDisplayNameTemplate}"
					SelectionChanged="GameVersion_SelectionChanged"
				/>
			</controls:HeaderedContentControl>

			<controls:HeaderedContentControl
				Header="Gender"
				Style="{StaticResource HeaderedFieldStyle}"
			>
				<controls:Segmented
					x:Name="Gender"
					ItemsSource="{ui:EnumValues Type=cmx:GenderFilter}"
					SelectedItem="{x:Bind viewModel.Gender, Mode=OneWay}"
					ItemTemplate="{StaticResource EnumDisplayNameTemplate}"
					SelectionChanged="Gender_SelectionChanged"
				/>
			</controls:HeaderedContentControl>
		</controls:WrapPanel>

		<ListView
			x:Name="ColorSetList"
			Grid.Row="2"
			Padding="24,0,24,24"
			ItemsSource="{x:Bind viewModel.ColorSets, Mode=OneWay}"
			SelectionMode="None"
		>
			<ListView.Header>
				<Border
					Padding="8,4,0,4"
					Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
					CornerRadius="4"
				>
					<!-- TODO: this doesn't stick until window is resized? -->
					<interactivity:Interaction.Behaviors>
						<behaviors:StickyHeaderBehavior />
					</interactivity:Interaction.Behaviors>

					<controls:DataTable ColumnSpacing="16">
						<controls:DataColumn Content="ID" MinWidth="40" />
						<controls:DataColumn Content="Name (EN)" MinWidth="200" />
						<controls:DataColumn Content="Name (JP)" MinWidth="200" />
						<controls:DataColumn Content="Outerwear" />
						<controls:DataColumn Content="Basewear" />
						<controls:DataColumn Content="Innerwear" />
					</controls:DataTable>
				</Border>
			</ListView.Header>

			<ListView.ItemTemplate>
				<DataTemplate x:DataType="pso:CmxColorSet">
					<Grid Padding="16,0,12,0">
						<controls:DataRow HorizontalAlignment="Left">
							<TextBlock VerticalAlignment="Center" Text="{x:Bind Id}" />
							<TextBlock
								VerticalAlignment="Center"
								Text="{x:Bind NamesEn}"
								Padding="0,8,0,8"
							/>
							<TextBlock
								VerticalAlignment="Center"
								Text="{x:Bind NamesJp}"
								Padding="0,8,0,8"
							/>
							<StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,24,8">
								<cmxcontrols:ColorBlock
									Width="32"
									Height="32"
									Color="{x:Bind Colors.Outerwear1}"
								/>
								<cmxcontrols:ColorBlock
									Width="32"
									Height="32"
									Color="{x:Bind Colors.Outerwear2}"
								/>
							</StackPanel>
							<StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,24,8">
								<cmxcontrols:ColorBlock
									Width="32"
									Height="32"
									Color="{x:Bind Colors.Basewear1}"
								/>
								<cmxcontrols:ColorBlock
									Width="32"
									Height="32"
									Color="{x:Bind Colors.Basewear2}"
								/>
							</StackPanel>
							<StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,24,8">
								<cmxcontrols:ColorBlock
									Width="32"
									Height="32"
									Color="{x:Bind Colors.Innerwear1}"
								/>
								<cmxcontrols:ColorBlock
									Width="32"
									Height="32"
									Color="{x:Bind Colors.Innerwear2}"
								/>
							</StackPanel>
						</controls:DataRow>
					</Grid>
				</DataTemplate>
			</ListView.ItemTemplate>

			<ListView.ItemContainerStyle>
				<Style
					BasedOn="{StaticResource DefaultListViewItemStyle}"
					TargetType="ListViewItem"
				>
					<Setter Property="Padding" Value="0,0,0,0" />
					<Setter Property="HorizontalContentAlignment" Value="Left" />
				</Style>
			</ListView.ItemContainerStyle>
		</ListView>

		<ProgressRing x:Name="Progress" Grid.Row="2" IsActive="True" />
	</Grid>
</Page>
