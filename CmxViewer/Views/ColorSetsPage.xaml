<?xml version="1.0" encoding="utf-8"?>
<Page
	x:Class="Pso2Tools.CmxViewer.Views.ColorSetsPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Pso2Tools.CmxViewer.Views"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	xmlns:pso="using:Pso2Tools"
	xmlns:cmx="using:Pso2Tools.CmxViewer"
	xmlns:cmxcontrols="using:Pso2Tools.CmxViewer.Controls"
	xmlns:ui="using:CommunityToolkit.WinUI"
	xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
	xmlns:controls="using:CommunityToolkit.WinUI.Controls"
	xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
>
	<Grid>
		<VisualStateManager.VisualStateGroups>
			<VisualStateGroup>
				<VisualState x:Name="Loading">
					<VisualState.Setters>
						<Setter Target="Progress.IsActive" Value="True" />
						<Setter Target="Progress.Visibility" Value="Visible" />
					</VisualState.Setters>
				</VisualState>
				<VisualState x:Name="Ready" />
			</VisualStateGroup>
		</VisualStateManager.VisualStateGroups>

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<TextBlock
			Text="Color Sets"
			Style="{StaticResource SubtitleTextBlockStyle}"
			Margin="36,24,36,16"
		/>

		<!-- TODO: down arrow from one of these controls should move focus to list. Up arrow at top of list should move back to controls. -->
		<controls:WrapPanel
			Grid.Row="1"
			Orientation="Horizontal"
			VerticalAlignment="Bottom"
			HorizontalSpacing="24"
			VerticalSpacing="16"
			Margin="36,0,36,16"
		>
			<AutoSuggestBox
				VerticalAlignment="Bottom"
				Width="200"
				Text="{x:Bind viewModel.FilterText, Mode=TwoWay}"
				PlaceholderText="Search"
				QueryIcon="Find"
			/>

			<controls:HeaderedContentControl
				Header="Sort"
				Style="{StaticResource HeaderedFieldStyle}"
			>
				<StackPanel Orientation="Horizontal" Spacing="8">
					<controls:Segmented
						x:Name="SortProperty"
						ItemsSource="{ui:EnumValues Type=cmx:SortProperty}"
						SelectedItem="{x:Bind viewModel.Settings.SortProperty, Mode=OneWay}"
						ItemTemplate="{StaticResource EnumDisplayNameTemplate}"
						SelectionChanged="SortProperty_SelectionChanged"
					/>

					<controls:Segmented
						x:Name="SortDirection"
						xmlns:collections="using:CommunityToolkit.WinUI.Collections"
						ItemsSource="{ui:EnumValues Type=collections:SortDirection}"
						SelectedItem="{x:Bind viewModel.Settings.SortDirection, Mode=OneWay}"
						ItemTemplate="{StaticResource SortDirectionIconTemplate}"
						SelectionChanged="SortDirection_SelectionChanged"
					/>
				</StackPanel>
			</controls:HeaderedContentControl>

			<controls:HeaderedContentControl
				Header="Game version"
				Style="{StaticResource HeaderedFieldStyle}"
			>
				<controls:Segmented
					x:Name="GameVersion"
					ItemsSource="{ui:EnumValues Type=cmx:GameVersion}"
					SelectedItem="{x:Bind viewModel.Settings.GameVersionFilter, Mode=OneWay}"
					ItemTemplate="{StaticResource EnumDisplayNameTemplate}"
					SelectionChanged="GameVersion_SelectionChanged"
				/>
			</controls:HeaderedContentControl>

			<controls:HeaderedContentControl
				Header="Body type"
				Style="{StaticResource HeaderedFieldStyle}"
			>
				<controls:Segmented
					x:Name="BodyType"
					ItemsSource="{ui:EnumValues Type=cmx:BodyType}"
					SelectedItem="{x:Bind viewModel.Settings.BodyTypeFilter, Mode=OneWay}"
					ItemTemplate="{StaticResource EnumDisplayNameTemplate}"
					SelectionChanged="BodyType_SelectionChanged"
				/>
			</controls:HeaderedContentControl>
		</controls:WrapPanel>

		<ListView
			x:Name="ColorSetList"
			Grid.Row="2"
			Padding="24,0,24,24"
			ItemsSource="{x:Bind viewModel.ColorSets, Mode=OneWay}"
			SelectionMode="None"
			ContainerContentChanging="ColorSetList_ContainerContentChanging"
		>
			<ListView.Header>
				<Border
					Padding="12,4,0,4"
					Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
					CornerRadius="4"
				>
					<!-- TODO: this doesn't stick until window is resized? -->
					<interactivity:Interaction.Behaviors>
						<behaviors:StickyHeaderBehavior />
					</interactivity:Interaction.Behaviors>

					<controls:DataTable ColumnSpacing="16">
						<controls:DataColumn Content="ID" MinWidth="40" />
						<controls:DataColumn Content="Name (EN)" MinWidth="200" />
						<controls:DataColumn Content="Name (JP)" MinWidth="200" />
						<controls:DataColumn Content="Outerwear" />
						<controls:DataColumn Content="Basewear" />
						<controls:DataColumn Content="Innerwear" />
					</controls:DataTable>
				</Border>
			</ListView.Header>

			<ListView.ItemTemplate>
				<DataTemplate x:DataType="pso:CmxColorSet">
					<Grid Padding="16,0,12,0">
						<controls:DataRow HorizontalAlignment="Left">
							<TextBlock VerticalAlignment="Center" Text="{x:Bind Id}" />
							<TextBlock
								VerticalAlignment="Center"
								Padding="0,8,0,8"
								Text="{x:Bind NamesEn, TargetNullValue='Unnamed'}"
								Opacity="{x:Bind NamesEn, Converter={StaticResource DimIfNullConverter}}"
							/>
							<TextBlock
								VerticalAlignment="Center"
								Padding="0,8,0,8"
								Text="{x:Bind NamesJp, TargetNullValue='Unnamed'}"
								Opacity="{x:Bind NamesJp, Converter={StaticResource DimIfNullConverter}}"
							/>
							<!-- TODO would be nice if left/right arrow keys moved focus between color blocks -->
							<StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,24,8">
								<cmxcontrols:ColorBlock
									Width="32"
									Height="32"
									Color="{x:Bind Colors.Outerwear1}"
									ToolTipService.ToolTip="Outerwear color 1"
								/>
								<cmxcontrols:ColorBlock
									Width="32"
									Height="32"
									Color="{x:Bind Colors.Outerwear2}"
									ToolTipService.ToolTip="Outerwear color 2"
								/>
							</StackPanel>
							<StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,24,8">
								<cmxcontrols:ColorBlock
									Width="32"
									Height="32"
									Color="{x:Bind Colors.Basewear1}"
									ToolTipService.ToolTip="Basewear color 1"
								/>
								<cmxcontrols:ColorBlock
									Width="32"
									Height="32"
									Color="{x:Bind Colors.Basewear2}"
									ToolTipService.ToolTip="Basewear color 2"
								/>
							</StackPanel>
							<StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,24,8">
								<cmxcontrols:ColorBlock
									Width="32"
									Height="32"
									Color="{x:Bind Colors.Innerwear1}"
									ToolTipService.ToolTip="Innerwear color 1"
								/>
								<cmxcontrols:ColorBlock
									Width="32"
									Height="32"
									Color="{x:Bind Colors.Innerwear2}"
									ToolTipService.ToolTip="Innerwear color 2"
								/>
							</StackPanel>
						</controls:DataRow>
					</Grid>
				</DataTemplate>
			</ListView.ItemTemplate>

			<ListView.ItemContainerStyle>
				<Style
					BasedOn="{StaticResource DefaultListViewItemStyle}"
					TargetType="ListViewItem"
				>
					<Setter Property="Padding" Value="0,0,0,0" />
					<Setter Property="HorizontalContentAlignment" Value="Left" />
				</Style>
			</ListView.ItemContainerStyle>
		</ListView>

		<ProgressRing x:Name="Progress" Grid.Row="2" Visibility="Collapsed" />
	</Grid>
</Page>
