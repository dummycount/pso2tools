<?xml version="1.0" encoding="utf-8"?>
<Page
	x:Class="Pso2Tools.CmxViewer.Views.SettingsPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Pso2Tools.CmxViewer.Views"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:controls="using:CommunityToolkit.WinUI.Controls"
	mc:Ignorable="d"
>
	<Page.Resources>
		<Style
			x:Key="SettingsSectionHeaderTextBlockStyle"
			BasedOn="{StaticResource BodyStrongTextBlockStyle}"
			TargetType="TextBlock"
		>
			<Style.Setters>
				<Setter Property="Margin" Value="1,30,0,6" />
			</Style.Setters>
		</Style>
	</Page.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<TextBlock
			Text="Settings"
			Style="{StaticResource TitleTextBlockStyle}"
			Margin="36,24,36,0"
			MaxWidth="1064"
		/>

		<ScrollView
			Grid.Row="1"
			IsTabStop="False"
			Padding="36,0,36,0"
			VerticalScrollBarVisibility="Auto"
			VerticalScrollMode="Auto"
		>
			<Border>
				<StackPanel MaxWidth="1064" Spacing="4">
					<StackPanel.ChildrenTransitions>
						<RepositionThemeTransition />
					</StackPanel.ChildrenTransitions>

					<TextBlock
						Text="Appearance &amp; behavior"
						Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
					/>

					<controls:SettingsCard
						Header="Path to pso2_bin folder"
						Description="{x:Bind settings.Pso2BinPath, TargetNullValue='No path set', Mode=OneWay}"
					>
						<controls:SettingsCard.HeaderIcon>
							<FontIcon Glyph="&#xE8B7;" />
						</controls:SettingsCard.HeaderIcon>

						<StackPanel Orientation="Horizontal" Spacing="8">
							<Button
								x:Name="DataPathResetButton"
								Content="Default"
								Click="DataPathResetButton_Click"
								MinWidth="120"
							/>
							<Button
								x:Name="DataPathButton"
								Content="Select folder"
								Click="DataPathButton_Click"
								MinWidth="120"
							/>
						</StackPanel>
					</controls:SettingsCard>

					<controls:SettingsCard Header="Theme">
						<controls:SettingsCard.HeaderIcon>
							<FontIcon Glyph="&#xE790;" />
						</controls:SettingsCard.HeaderIcon>

						<ComboBox x:Name="ThemeMode" SelectionChanged="ThemeMode_SelectionChanged">
							<ComboBoxItem Content="Use system setting" Tag="Default" />
							<ComboBoxItem Content="Light" Tag="Light" />
							<ComboBoxItem Content="Dark" Tag="Dark" />
						</ComboBox>
					</controls:SettingsCard>

					<TextBlock
						Text="About"
						Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
					/>

					<controls:SettingsExpander Header="CMX Viewer">
						<controls:SettingsExpander.HeaderIcon>
							<ImageIcon Source="/Assets/Toolbox.ico" />
						</controls:SettingsExpander.HeaderIcon>

						<TextBlock
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							IsTextSelectionEnabled="True"
							Text="{x:Bind Version}"
						/>

						<controls:SettingsExpander.Items>
							<controls:SettingsCard
								x:Name="OpenRepoCard"
								Header="Open GitHub repository"
								IsClickEnabled="True"
								Click="OpenRepoCard_Click"
							>
								<TextBlock>https://github.com/dummycount/pso2tools</TextBlock>
								<controls:SettingsCard.ActionIcon>
									<FontIcon Glyph="&#xE8C8;" />
								</controls:SettingsCard.ActionIcon>
							</controls:SettingsCard>

							<controls:SettingsCard
								Header="Portions of this software are based on code from the following projects"
								ContentAlignment="Vertical"
								HorizontalContentAlignment="Left"
							>
								<StackPanel Margin="-12,0,0,0">
									<HyperlinkButton
										Content="PSO2 Aqua Library"
										NavigateUri="https://github.com/Shadowth117/PSO2-Aqua-Library"
									/>
									<HyperlinkButton
										Content="WinUI 3"
										NavigateUri="https://aka.ms/winui"
									/>
									<HyperlinkButton
										Content="WinUI 3 Gallery"
										NavigateUri="https://github.com/microsoft/WinUI-Gallery"
									/>
									<HyperlinkButton
										Content="Windows Community Toolkit"
										NavigateUri="https://aka.ms/toolkit/windows"
									/>
								</StackPanel>
							</controls:SettingsCard>
						</controls:SettingsExpander.Items>
					</controls:SettingsExpander>
				</StackPanel>
			</Border>
		</ScrollView>
	</Grid>
</Page>
