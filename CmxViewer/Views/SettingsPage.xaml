<?xml version="1.0" encoding="utf-8"?>
<Page
	x:Class="Pso2Tools.CmxViewer.Views.SettingsPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Pso2Tools.CmxViewer.Views"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:controls="using:CommunityToolkit.WinUI.Controls"
	mc:Ignorable="d"
>
	<Page.Resources>
		<Style
			x:Key="SettingsSectionHeaderTextBlockStyle"
			BasedOn="{StaticResource BodyStrongTextBlockStyle}"
			TargetType="TextBlock"
		>
			<Style.Setters>
				<Setter Property="Margin" Value="1,30,0,6" />
			</Style.Setters>
		</Style>
	</Page.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<TextBlock
			Text="Settings"
			Style="{StaticResource TitleTextBlockStyle}"
			Margin="36,24,36,0"
		/>

		<ScrollViewer
			Grid.Row="1"
			IsTabStop="False"
			VerticalScrollBarVisibility="Auto"
			VerticalScrollMode="Auto"
		>
			<StackPanel Spacing="4" Margin="36,0,36,0">
				<TextBlock
					Text="System"
					Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
				/>

				<controls:SettingsCard
					Header="Path to pso2_bin folder"
					Description="{x:Bind settings.Pso2BinPath, TargetNullValue='No path set', Mode=OneWay}"
				>
					<controls:SettingsCard.HeaderIcon>
						<FontIcon Glyph="&#xE8B7;" />
					</controls:SettingsCard.HeaderIcon>

					<StackPanel Orientation="Horizontal" Spacing="8">
						<Button
							x:Name="DataPathResetButton"
							Content="Default"
							Click="DataPathResetButton_Click"
							MinWidth="120"
						/>
						<Button
							x:Name="DataPathButton"
							Content="Select folder"
							Click="DataPathButton_Click"
							MinWidth="120"
						/>
					</StackPanel>
				</controls:SettingsCard>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</Page>
