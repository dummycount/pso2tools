<?xml version="1.0" encoding="utf-8"?>
<Page
	x:Class="Pso2Tools.CmxViewer.Views.CmxEntryListPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Pso2Tools.CmxViewer.Views"
	xmlns:model="using:Pso2Tools.CmxViewer.ViewModels"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:pso="using:Pso2Tools"
	xmlns:cmx="using:Pso2Tools.CmxViewer"
	xmlns:ui="using:CommunityToolkit.WinUI"
	xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
	xmlns:controls="using:CommunityToolkit.WinUI.Controls"
	xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
	mc:Ignorable="d"
>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<TextBlock
			Text="{x:Bind viewModel.ObjectType, Mode=OneWay, Converter={StaticResource EnumDisplayNameConverter}}"
			Style="{StaticResource SubtitleTextBlockStyle}"
			Margin="36,24,36,16"
		/>

		<controls:WrapPanel
			Grid.Row="1"
			Orientation="Horizontal"
			VerticalAlignment="Bottom"
			HorizontalSpacing="24"
			VerticalSpacing="16"
			Margin="36,0,36,16"
		>
			<AutoSuggestBox
				VerticalAlignment="Bottom"
				Width="200"
				Text="{x:Bind viewModel.FilterText, Mode=TwoWay}"
				PlaceholderText="Search"
				QueryIcon="Find"
			/>

			<controls:HeaderedContentControl
				Header="Sort"
				Style="{StaticResource HeaderedFieldStyle}"
			>
				<StackPanel Orientation="Horizontal" Spacing="8">
					<controls:Segmented
						x:Name="SortProperty"
						ItemsSource="{ui:EnumValues Type=cmx:SortProperty}"
						SelectedItem="{x:Bind viewModel.Settings.SortProperty, Mode=OneWay}"
						ItemTemplate="{StaticResource EnumDisplayNameTemplate}"
						SelectionChanged="SortProperty_SelectionChanged"
					/>

					<controls:Segmented
						x:Name="SortDirection"
						xmlns:collections="using:CommunityToolkit.WinUI.Collections"
						ItemsSource="{ui:EnumValues Type=collections:SortDirection}"
						SelectedItem="{x:Bind viewModel.Settings.SortDirection, Mode=OneWay}"
						ItemTemplate="{StaticResource SortDirectionIconTemplate}"
						SelectionChanged="SortDirection_SelectionChanged"
					/>
				</StackPanel>
			</controls:HeaderedContentControl>

			<controls:HeaderedContentControl
				Header="Game version"
				Style="{StaticResource HeaderedFieldStyle}"
				Visibility="{x:Bind viewModel.UsesGameVersion, Converter={StaticResource BoolToVisibilityConverter}}"
			>
				<controls:Segmented
					x:Name="GameVersion"
					ItemsSource="{ui:EnumValues Type=cmx:GameVersion}"
					SelectedItem="{x:Bind viewModel.Settings.GameVersionFilter, Mode=OneWay}"
					ItemTemplate="{StaticResource EnumDisplayNameTemplate}"
					SelectionChanged="GameVersion_SelectionChanged"
				/>
			</controls:HeaderedContentControl>

			<controls:HeaderedContentControl
				Header="Body type"
				Style="{StaticResource HeaderedFieldStyle}"
				Visibility="{x:Bind viewModel.UsesBodyType, Converter={StaticResource BoolToVisibilityConverter}}"
			>
				<controls:Segmented
					x:Name="BodyType"
					ItemsSource="{ui:EnumValues Type=cmx:BodyType}"
					SelectedItem="{x:Bind viewModel.Settings.BodyTypeFilter, Mode=OneWay}"
					ItemTemplate="{StaticResource EnumDisplayNameTemplate}"
					SelectionChanged="BodyType_SelectionChanged"
				/>
			</controls:HeaderedContentControl>
		</controls:WrapPanel>

		<ListView
			x:Name="EntryList"
			Grid.Row="2"
			Padding="20,0,20,24"
			ItemsSource="{x:Bind viewModel.Objects, Mode=OneWay}"
			IsItemClickEnabled="True"
			SelectionMode="None"
		>
			<ListView.Header>
				<Border
					Margin="4,0,0,0"
					Padding="8,4,0,4"
					Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
					CornerRadius="4"
				>
					<!-- TODO: this doesn't stick until window is resized? -->
					<interactivity:Interaction.Behaviors>
						<behaviors:StickyHeaderBehavior />
					</interactivity:Interaction.Behaviors>

					<controls:DataTable ColumnSpacing="16">
						<controls:DataColumn Content="ID" MinWidth="40" />
						<controls:DataColumn Content="Name (EN)" MinWidth="200" />
						<controls:DataColumn Content="Name (JP)" MinWidth="200" />
					</controls:DataTable>
				</Border>
			</ListView.Header>

			<ListView.ItemTemplate>
				<DataTemplate x:DataType="pso:ICmxEntry">
					<controls:DataRow HorizontalAlignment="Left">
						<TextBlock VerticalAlignment="Center" Text="{x:Bind Id}" />
						<TextBlock
							VerticalAlignment="Center"
							Text="{x:Bind Names.En, TargetNullValue='Unnamed'}"
							Opacity="{x:Bind Names.En, Converter={StaticResource DimIfNullConverter}}"
						/>
						<TextBlock
							VerticalAlignment="Center"
							Text="{x:Bind Names.Jp, TargetNullValue='Unnamed'}"
							Opacity="{x:Bind Names.Jp, Converter={StaticResource DimIfNullConverter}}"
						/>
					</controls:DataRow>
				</DataTemplate>
			</ListView.ItemTemplate>

			<ListView.ItemContainerStyle>
				<Style
					BasedOn="{StaticResource DefaultListViewItemStyle}"
					TargetType="ListViewItem"
				>
					<Setter Property="HorizontalContentAlignment" Value="Left" />
				</Style>
			</ListView.ItemContainerStyle>
		</ListView>

		<ProgressRing x:Name="Progress" Grid.Row="2" IsActive="True" />
	</Grid>
</Page>
