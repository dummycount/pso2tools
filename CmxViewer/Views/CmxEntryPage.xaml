<?xml version="1.0" encoding="utf-8"?>
<Page
	x:Class="Pso2Tools.CmxViewer.Views.CmxEntryPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Pso2Tools.CmxViewer.Views"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
>
	<Grid>
		<Grid.Resources>
			<x:Double x:Key="BreadcrumbBarChevronFontSize">20</x:Double>
		</Grid.Resources>

		<BreadcrumbBar x:Name="Breadcrumbs" Margin="36,24,36,16">
			<BreadcrumbBar.ItemTemplate>
				<DataTemplate x:DataType="x:String">
					<BreadcrumbBarItem Content="{Binding}">
						<BreadcrumbBarItem.ContentTemplate>
							<DataTemplate>
								<TextBlock
									Text="{Binding}"
									Style="{StaticResource SubtitleTextBlockStyle}"
								/>
							</DataTemplate>
						</BreadcrumbBarItem.ContentTemplate>
					</BreadcrumbBarItem>
				</DataTemplate>
			</BreadcrumbBar.ItemTemplate>
		</BreadcrumbBar>
	</Grid>
</Page>
