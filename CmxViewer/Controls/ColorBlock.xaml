<?xml version="1.0" encoding="utf-8"?>
<UserControl
	x:Class="Pso2Tools.CmxViewer.Controls.ColorBlock"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Pso2Tools.CmxViewer.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	xmlns:controls="using:CommunityToolkit.WinUI.Controls"
>
	<Grid>
		<!-- TODO: make border color change on hover -->
		<Button
			Click="Button_Click"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			HorizontalContentAlignment="Stretch"
			VerticalContentAlignment="Stretch"
			Padding="0"
			Background="Black"
		>
			<Border
				CornerRadius="2"
				Background="{x:Bind Color, Mode=OneWay, Converter={StaticResource ColorToBrushConverter}}"
				BorderBrush="Black"
				BorderThickness="2"
			/>
		</Button>
		<Popup x:Name="DataPopup" VerticalOffset="{x:Bind Height}" IsLightDismissEnabled="True">
			<Border
				Padding="16"
				CornerRadius="{StaticResource OverlayCornerRadius}"
				BorderThickness="1"
				BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
				Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
			>
				<StackPanel Spacing="16">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<controls:HeaderedContentControl
							Header="R"
							Style="{StaticResource ColorHeaderStyle}"
							Width="24"
							HorizontalContentAlignment="Right"
						>
							<TextBlock
								Text="{x:Bind Color.R, Mode=OneWay}"
								Style="{StaticResource CodeBlockStyle}"
							/>
						</controls:HeaderedContentControl>

						<controls:HeaderedContentControl
							Header="G"
							Style="{StaticResource ColorHeaderStyle}"
							Width="24"
							HorizontalContentAlignment="Right"
						>
							<TextBlock
								Text="{x:Bind Color.G, Mode=OneWay}"
								Style="{StaticResource CodeBlockStyle}"
							/>
						</controls:HeaderedContentControl>

						<controls:HeaderedContentControl
							Header="B"
							Style="{StaticResource ColorHeaderStyle}"
							Width="24"
							HorizontalContentAlignment="Right"
						>
							<TextBlock
								Text="{x:Bind Color.B, Mode=OneWay}"
								Style="{StaticResource CodeBlockStyle}"
							/>
						</controls:HeaderedContentControl>
					</StackPanel>
					<StackPanel Orientation="Horizontal" Spacing="12">
						<TextBlock
							Text="{x:Bind Hex, Mode=OneWay}"
							Style="{StaticResource CodeBlockStyle}"
							VerticalAlignment="Center"
						/>
						<local:CopyButton
							x:Name="CopyButton"
							Click="CopyButton_Click"
							Content="&#xE8C8;"
						/>
					</StackPanel>
				</StackPanel>
			</Border>
		</Popup>
	</Grid>
</UserControl>
