<?xml version="1.0" encoding="utf-8"?>
<UserControl
	x:Class="Pso2Tools.CmxViewer.Controls.ColorBlock"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Pso2Tools.CmxViewer.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
>
	<Grid>
		<Border
			CornerRadius="4"
			BorderBrush="{StaticResource ControlElevationBorderBrush}"
			BorderThickness="1"
		>
			<Border
				CornerRadius="3"
				Background="{x:Bind Color, Mode=OneWay, Converter={StaticResource ColorToBrushConverter}}"
				BorderBrush="Black"
				BorderThickness="2"
			/>
		</Border>
	</Grid>
</UserControl>
